# name and e-mail live in ./identity, which is not in the repo
# (see identity.example)
[include]
	path = identity

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
	syntax-theme = base16-256
	dark = true
	minus-style = syntax "#2a1c1c"
	plus-style = syntax "#1c2a1c"

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	lg = log --graph --oneline --decorate --all
	amend = commit --amend --no-edit
