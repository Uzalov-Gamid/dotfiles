# Terminal toolchain for this dotfiles setup.
# Install everything with: brew bundle --file=Brewfile

# Core
brew "git"
brew "gh"

# Shell & prompt
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Multiplexer & editor
brew "tmux"
brew "neovim"

# Search & navigation
brew "ripgrep"
brew "fd"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"

# Git tooling
brew "lazygit"
brew "git-delta"

# Runtimes used by LSP servers Neovim installs via Mason
brew "node"
brew "python@3.14"
brew "go"

# Terminal & font
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
