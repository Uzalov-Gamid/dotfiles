#!/usr/bin/env bash

# Load Scripting Addition
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout float

yabai -m config window_opacity on
yabai -m config active_window_opacity 0.97
yabai -m config normal_window_opacity 0.97

opaque_apps=(
  "Zen"
  "Safari"
  "Preview"
  "QuickTime Player"
  "Firefox Nightly"
  # "Code"
)

for app in "${opaque_apps[@]}"; do
  yabai -m rule --add app="^${app}$" opacity=1.0
done

sleep 0.3

for app in "${opaque_apps[@]}"; do
  yabai -m query --windows \
    | jq -r --arg app "$app" '.[] | select(.app == $app) | .id' \
    | while read -r id; do
        yabai -m window "$id" --opacity 1.0
      done
done

